#!/usr/bin/env bash
# Git pre-push hook — fast sanity checks only.
# Full test suite runs in CI (go test -race, cspell, e2e, etc.)
# Install with: make hooks

set -euo pipefail

echo "Running pre-push checks..."

# Go vet (~2s)
echo "Running go vet..."
cd packages/daemon && go vet ./... || exit 1
cd ../..
cd packages/build-service && go vet ./... || exit 1
cd ../..

# Web checks: typecheck + lint + format (~5s)
if [ -f packages/web/package.json ]; then
  echo "Running web typecheck..."
  cd packages/web && pnpm typecheck || exit 1
  cd ../..
  echo "Running web lint..."
  cd packages/web && pnpm lint || exit 1
  cd ../..
  echo "Running web format check..."
  cd packages/web && pnpm format:check || exit 1
  cd ../..
fi

echo "All pre-push checks passed."
