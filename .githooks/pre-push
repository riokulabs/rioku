#!/usr/bin/env bash
# Git pre-push hook — `go vet` smoke only (< 3s typical).
# Contract: see contrib-docs/docs/development/hooks.md
# Full test suite, web checks, lint, e2e all run in PR CI.
# Install with: make hooks

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)

echo "Running pre-push checks (go vet smoke)..."
(cd "$REPO_ROOT/packages/daemon" && go vet ./...) || exit 1
(cd "$REPO_ROOT/packages/build-service" && go vet ./...) || exit 1
echo "All pre-push checks passed."
