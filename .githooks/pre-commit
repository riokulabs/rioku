#!/usr/bin/env bash
# Git pre-commit hook — runs fast checks on staged files.
# Install with: make hooks

set -euo pipefail

STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
STAGED_PROTO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.proto$' || true)

# Go formatting — auto-fix and re-stage
if [ -n "$STAGED_GO" ]; then
  UNFORMATTED=$(gofmt -l $STAGED_GO 2>/dev/null || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "Formatting Go files..."
    gofmt -w $UNFORMATTED
    git add $UNFORMATTED
    echo "  formatted and re-staged: $UNFORMATTED"
  fi

  # Go vet — only run on modules that have staged files and can be vetted.
  # Walks up from each staged file to find its go.mod, then vets that module.
  # Modules in go.work use workspace mode; standalone modules (sandbox) use GOWORK=off.
  echo "Running go vet..."
  REPO_ROOT=$(git rev-parse --show-toplevel)
  declare -A VETTED_MODS
  GOWORK_FILE="$REPO_ROOT/go.work"
  for f in $STAGED_GO; do
    dir="$REPO_ROOT/$(dirname "$f")"
    while [ "$dir" != "$REPO_ROOT" ] && [ "$dir" != "/" ]; do
      if [ -f "$dir/go.mod" ]; then
        if [ -z "${VETTED_MODS[$dir]+x}" ]; then
          VETTED_MODS[$dir]=1
          # Check if this module is listed in go.work
          REL_DIR="${dir#"$REPO_ROOT/"}"
          if [ -f "$GOWORK_FILE" ] && grep -q "$REL_DIR" "$GOWORK_FILE" 2>/dev/null; then
            echo "  vet: $dir (workspace)"
            (cd "$dir" && go vet ./... 2>&1) || exit 1
          else
            echo "  vet: $dir (standalone)"
            (cd "$dir" && GOWORK=off go vet ./... 2>&1) || exit 1
          fi
        fi
        break
      fi
      dir=$(dirname "$dir")
    done
  done
fi

# Proto lint
if [ -n "$STAGED_PROTO" ]; then
  if command -v buf &>/dev/null; then
    echo "Running buf lint..."
    cd packages/proto && buf lint || exit 1
    cd ../..
  fi
fi
