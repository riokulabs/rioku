#!/usr/bin/env bash
# Git pre-commit hook — fast checks on staged files (< 5s typical).
# Contract: see contrib-docs/docs/development/hooks.md
# Install with: make hooks

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
STAGED_PROTO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.proto$' || true)
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)

# ── Go: gofmt + goimports auto-fix, then go vet on touched modules ────────────
if [ -n "$STAGED_GO" ]; then
  # gofmt — auto-fix + re-stage
  UNFORMATTED=$(gofmt -l $STAGED_GO 2>/dev/null || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "Formatting Go files (gofmt)..."
    gofmt -w $UNFORMATTED
    git add $UNFORMATTED
    echo "  formatted and re-staged: $UNFORMATTED"
  fi

  # goimports — auto-fix + re-stage. Skip silently if not installed.
  if command -v goimports &>/dev/null; then
    UNIMPORTED=$(goimports -l $STAGED_GO 2>/dev/null || true)
    if [ -n "$UNIMPORTED" ]; then
      echo "Fixing imports (goimports)..."
      goimports -w $UNIMPORTED
      git add $UNIMPORTED
      echo "  re-staged: $UNIMPORTED"
    fi
  fi

  # go vet — per touched module, workspace-aware via go.work.
  echo "Running go vet..."
  declare -A VETTED_MODS
  GOWORK_FILE="$REPO_ROOT/go.work"
  for f in $STAGED_GO; do
    dir="$REPO_ROOT/$(dirname "$f")"
    while [ "$dir" != "$REPO_ROOT" ] && [ "$dir" != "/" ]; do
      if [ -f "$dir/go.mod" ]; then
        if [ -z "${VETTED_MODS[$dir]+x}" ]; then
          VETTED_MODS[$dir]=1
          REL_DIR="${dir#"$REPO_ROOT/"}"
          if [ -f "$GOWORK_FILE" ] && grep -q "$REL_DIR" "$GOWORK_FILE" 2>/dev/null; then
            echo "  vet: $dir (workspace)"
            (cd "$dir" && go vet ./... 2>&1) || exit 1
          else
            echo "  vet: $dir (standalone)"
            (cd "$dir" && GOWORK=off go vet ./... 2>&1) || exit 1
          fi
        fi
        break
      fi
      dir=$(dirname "$dir")
    done
  done
fi

# ── Proto: buf lint on staged .proto files ────────────────────────────────────
if [ -n "$STAGED_PROTO" ]; then
  if command -v buf &>/dev/null; then
    echo "Running buf lint..."
    (cd "$REPO_ROOT/packages/proto" && buf lint) || exit 1
  fi
fi

# ── Web/UI TS: eslint --fix on staged files in packages/web and packages/ui ───
# Changed-files only. Skip silently if pnpm or eslint isn't installed.
if [ -n "$STAGED_TS" ] && command -v pnpm &>/dev/null; then
  for pkg in web ui; do
    PKG_PREFIX="packages/$pkg/"
    PKG_FILES=$(echo "$STAGED_TS" | grep "^${PKG_PREFIX}" || true)
    if [ -n "$PKG_FILES" ]; then
      # Strip the package prefix; eslint runs from the package dir.
      REL_FILES=$(echo "$PKG_FILES" | sed "s|^${PKG_PREFIX}||")
      if [ -d "$REPO_ROOT/packages/$pkg/node_modules/eslint" ]; then
        echo "Running eslint (packages/$pkg, changed files)..."
        (cd "$REPO_ROOT/packages/$pkg" && pnpm exec eslint --fix --max-warnings=0 $REL_FILES) || exit 1
        # Re-stage anything --fix touched.
        for f in $PKG_FILES; do
          git add "$f" 2>/dev/null || true
        done
      fi
    fi
  done
fi

# ── Stage-2 worktree shared-file warning (§8.4 file ownership) ────────────────
# When committing inside a stage-2 plan worktree, warn (don't block) if any
# staged file is in a known multi-plan-shared location. Hard enforcement
# happens at PR review.
if [[ "$PWD" =~ \.worktrees/stage2/(plan-[0-9]+[a-z]?-[a-z0-9-]+) ]]; then
  PLAN="${BASH_REMATCH[1]}"
  STAGED=$(git diff --cached --name-only)
  WARNED=0
  for f in $STAGED; do
    case "$f" in
      packages/web/src/api/mock-store/_internal.ts|packages/web/src/api/mock-seed/_internal.ts|packages/web/src/api/mock-store/index.ts|packages/web/src/api/mock-seed/index.ts|packages/web/src/api/resources/index.ts|packages/web/src/api/legacy-shim.ts)
        echo "  ⚠ $f is a multi-plan-shared file — confirm $PLAN owns this edit per §8.4" >&2
        WARNED=1
        ;;
    esac
  done
  if [ "$WARNED" -eq 1 ]; then
    echo "  (warnings only; commit allowed. Hard enforcement at PR review.)" >&2
  fi
fi
