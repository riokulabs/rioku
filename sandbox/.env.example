# Rioku Sandbox Environment Configuration
# Copy to .env and modify as needed: cp .env.example .env
#
# All values below are defaults — uncomment and change only what you need.

# Daemon ports
SANDBOX_PORT_REST=7778
SANDBOX_PORT_GRPC=7777
SANDBOX_PORT_TRAFFIC=8443
SANDBOX_PORT_CADDY_ADMIN=2019

# Sandbox upstream app ports
SANDBOX_PORT_USERS=9001
SANDBOX_PORT_PRODUCTS=9002
SANDBOX_PORT_WEBHOOKS=9003
SANDBOX_PORT_AUTH=9004
SANDBOX_PORT_MEDIA=9005

# Daemon config overrides
SANDBOX_DEV_MODE=true
SANDBOX_RATE_LIMIT_RPM=6000
SANDBOX_RATE_LIMIT_BURST=100
SANDBOX_REST_BIND=0.0.0.0

# Stage-2 added containers (default ports use +10000 shift to avoid host collisions)
SANDBOX_PORT_MAILPIT_SMTP=11025
SANDBOX_PORT_MAILPIT_UI=18025
SANDBOX_PORT_POSTGRES=15432
SANDBOX_PORT_PROMETHEUS=19090
SANDBOX_PORT_GRAFANA=13000
SANDBOX_PORT_OTEL_GRPC=14317
SANDBOX_PORT_OTEL_HTTP=14318
SANDBOX_PORT_TEMPO=13200
SANDBOX_PORT_PEBBLE_ACME=14000
SANDBOX_PORT_PEBBLE_MGMT=15000

# SMTP (daemon points at mailpit by default in sandbox)
SANDBOX_SMTP_HOST=localhost
SANDBOX_SMTP_PORT=${SANDBOX_PORT_MAILPIT_SMTP}
SANDBOX_SMTP_FROM=noreply@rioku.local
