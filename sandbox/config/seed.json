{
  "_comment": "Sandbox seed configuration. Applied via POST /api/v1/config after daemon starts.",
  "services": [
    {
      "name": "users-upstream",
      "upstreams": [
        {"address": "localhost:9001"},
        {"address": "localhost:9001"}
      ],
      "lbPolicy": "LB_POLICY_ROUND_ROBIN"
    },
    {
      "name": "products-upstream",
      "upstreams": [
        {"address": "localhost:9002"},
        {"address": "localhost:9002"}
      ],
      "lbPolicy": "LB_POLICY_WEIGHTED_ROUND_ROBIN"
    },
    {
      "name": "webhooks-upstream",
      "upstreams": [{"address": "localhost:9003"}],
      "lbPolicy": "LB_POLICY_LEAST_CONN"
    },
    {
      "name": "auth-upstream",
      "upstreams": [
        {"address": "localhost:9004"},
        {"address": "localhost:9004"}
      ],
      "lbPolicy": "LB_POLICY_ROUND_ROBIN"
    },
    {
      "name": "media-upstream",
      "upstreams": [{"address": "localhost:9005"}],
      "lbPolicy": "LB_POLICY_RANDOM"
    }
  ],
  "policies": [
    {
      "name": "rate-limit-standard",
      "type": "POLICY_TYPE_RATE_LIMIT",
      "config": {
        "requests_per_second": 100,
        "burst": 20,
        "scope": "per_ip"
      }
    },
    {
      "name": "rate-limit-strict",
      "type": "POLICY_TYPE_RATE_LIMIT",
      "config": {
        "requests_per_second": 10,
        "burst": 5,
        "scope": "per_ip"
      }
    },
    {
      "name": "auth-api-key",
      "type": "POLICY_TYPE_AUTH_API_KEY",
      "config": {
        "header": "X-API-Key",
        "validation_url": "http://localhost:9004/validate"
      }
    },
    {
      "name": "cors-allow-all",
      "type": "POLICY_TYPE_CORS",
      "config": {
        "allowed_origins": ["*"],
        "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
        "allowed_headers": ["Content-Type", "Authorization", "X-API-Key"],
        "max_age_seconds": 3600
      }
    }
  ],
  "routes": [
    {
      "name": "users-api",
      "enabled": true,
      "matchers": [
        {
          "hosts": ["api.local"],
          "paths": [{"type": "TYPE_PREFIX", "value": "/v1/users"}],
          "methods": ["GET", "POST", "PUT", "DELETE"]
        }
      ],
      "serviceRef": "users-upstream",
      "policyRefs": ["rate-limit-standard", "auth-api-key"]
    },
    {
      "name": "products-api",
      "enabled": true,
      "matchers": [
        {
          "hosts": ["api.local"],
          "paths": [{"type": "TYPE_PREFIX", "value": "/v1/products"}],
          "methods": ["GET", "POST", "PUT", "DELETE"]
        }
      ],
      "serviceRef": "products-upstream",
      "policyRefs": ["rate-limit-standard"]
    },
    {
      "name": "products-search",
      "enabled": true,
      "matchers": [
        {
          "hosts": ["api.local"],
          "paths": [{"type": "TYPE_PREFIX", "value": "/v1/search"}],
          "methods": ["GET"]
        }
      ],
      "serviceRef": "products-upstream",
      "policyRefs": ["rate-limit-strict"]
    },
    {
      "name": "webhooks-inbound",
      "enabled": true,
      "matchers": [
        {
          "hosts": ["hooks.local"],
          "paths": [{"type": "TYPE_PREFIX", "value": "/"}],
          "methods": ["POST"]
        }
      ],
      "serviceRef": "webhooks-upstream",
      "policyRefs": ["rate-limit-strict", "auth-api-key"]
    },
    {
      "name": "auth-login",
      "enabled": true,
      "matchers": [
        {
          "hosts": ["auth.local"],
          "paths": [{"type": "TYPE_EXACT", "value": "/login"}],
          "methods": ["POST"]
        }
      ],
      "serviceRef": "auth-upstream",
      "policyRefs": ["rate-limit-strict"]
    },
    {
      "name": "auth-api",
      "enabled": true,
      "matchers": [
        {
          "hosts": ["auth.local"],
          "paths": [{"type": "TYPE_PREFIX", "value": "/v1/"}],
          "methods": ["GET", "POST", "PUT", "DELETE"]
        }
      ],
      "serviceRef": "auth-upstream",
      "policyRefs": ["rate-limit-standard", "auth-api-key"]
    },
    {
      "name": "media-assets",
      "enabled": true,
      "matchers": [
        {
          "hosts": ["media.local", "cdn.local"],
          "paths": [{"type": "TYPE_PREFIX", "value": "/assets/"}]
        }
      ],
      "serviceRef": "media-upstream",
      "policyRefs": []
    },
    {
      "name": "media-upload",
      "enabled": true,
      "matchers": [
        {
          "hosts": ["media.local"],
          "paths": [{"type": "TYPE_PREFIX", "value": "/upload"}],
          "methods": ["POST", "PUT"]
        }
      ],
      "serviceRef": "media-upstream",
      "policyRefs": ["auth-api-key", "rate-limit-strict"]
    },
    {
      "name": "health-check",
      "enabled": true,
      "matchers": [
        {
          "paths": [{"type": "TYPE_EXACT", "value": "/healthz"}]
        }
      ],
      "serviceRef": "users-upstream",
      "policyRefs": []
    },
    {
      "name": "legacy-redirect",
      "enabled": false,
      "matchers": [
        {
          "hosts": ["old.local"],
          "paths": [{"type": "TYPE_PREFIX", "value": "/"}]
        }
      ],
      "serviceRef": "users-upstream",
      "policyRefs": []
    }
  ]
}
