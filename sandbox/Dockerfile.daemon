# sandbox/Dockerfile.daemon — Multi-stage build for the Rioku daemon with embedded web admin.
#
# Stage 1: Build the React admin panel
# Stage 2: Build the Go daemon binary with embedded web assets
# Stage 3: Minimal runtime image

# ── Stage 1: Web Admin ──────────────────────────────────────
FROM node:22-bookworm-slim AS web-builder
RUN corepack enable
WORKDIR /src/packages/web
COPY packages/web/package.json packages/web/pnpm-lock.yaml packages/web/.npmrc ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY packages/web/ ./
RUN pnpm build

# ── Stage 2: Daemon Binary ──────────────────────────────────
FROM golang:1.24-bookworm AS daemon-builder
WORKDIR /src
COPY go.work go.work.sum ./
COPY packages/daemon/ packages/daemon/
COPY packages/proto/ packages/proto/
COPY --from=web-builder /src/packages/web/build packages/daemon/web/build/
RUN cd packages/daemon && CGO_ENABLED=1 go build -o /rioku ./cmd/rioku

# ── Stage 3: Runtime ────────────────────────────────────────
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=daemon-builder /rioku /usr/local/bin/rioku
COPY sandbox/scripts/container-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 7778 7777 8443
VOLUME /data
ENTRYPOINT ["/entrypoint.sh"]
