{
  "name": "@rioku/web",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b tsconfig.node.json && tsc --noEmit",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "bundle-analyze": "vite-bundle-analyzer dist/stats.html",
    "check-budgets": "node scripts/check-bundle-budgets.mjs",
    "check-abi": "node scripts/check-abi-surface.mjs",
    "abi:update": "node scripts/check-abi-surface.mjs --update",
    "types:gen": "orval --config orval.config.ts && prettier --write 'src/api/generated/**/*.zod.ts' && node scripts/suppress-generated-typecheck.mjs",
    "types:gen:incremental": "orval --config orval.config.ts --watch=false && prettier --write 'src/api/generated/**/*.zod.ts' && node scripts/suppress-generated-typecheck.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/carousel": "9.0.2",
    "@mantine/charts": "9.0.2",
    "@mantine/code-highlight": "9.0.2",
    "@mantine/core": "9.0.2",
    "@mantine/dates": "9.0.2",
    "@mantine/dropzone": "9.0.2",
    "@mantine/form": "9.0.2",
    "@mantine/hooks": "9.0.2",
    "@mantine/modals": "9.0.2",
    "@mantine/notifications": "9.0.2",
    "@mantine/nprogress": "9.0.2",
    "@mantine/spotlight": "9.0.2",
    "@mantine/tiptap": "9.0.2",
    "@monaco-editor/react": "4.7.0",
    "@scalar/api-reference-react": "0.9.24",
    "@tabler/icons-react": "3.41.1",
    "@tanstack/react-query": "5.99.0",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-table": "8.21.3",
    "cel-js": "^0.8.2",
    "colord": "^2.9.3",
    "dayjs": "^1.11.13",
    "embla-carousel-react": "^8.5.0",
    "i18next": "26.0.5",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "3.0.4",
    "monaco-editor": "0.55.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "17.0.4",
    "recharts": "3.8.1",
    "shiki": "4.0.2",
    "zod": "4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "1.59.1",
    "@tanstack/react-query-devtools": "5.99.0",
    "@tanstack/router-devtools": "1.166.13",
    "@tanstack/router-plugin": "1.167.22",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.9.0",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "4.1.4",
    "eslint": "10.2.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest-axe": "^9.0.0",
    "jsdom": "29.0.2",
    "msw": "2.13.4",
    "orval": "7.5.0",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2",
    "vite": "8.0.8",
    "vite-bundle-analyzer": "^0.11.0",
    "vitest": "4.1.4"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks>eslint": "$eslint",
      "eslint-plugin-react>eslint": "$eslint"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "msw"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
