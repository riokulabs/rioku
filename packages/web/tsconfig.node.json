{
  "compilerOptions": {
    "composite": true,
    "outDir": ".tsc-node-out",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "postcss.config.mjs",
    "eslint.config.mjs",
    "e2e/global-setup.ts",
    "e2e/auth/**/*.ts"
  ]
}
