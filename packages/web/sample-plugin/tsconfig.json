{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "src",
    "paths": {
      "@rioku/plugin-sdk": ["../../src/host/sdk.ts"],
      // `@/*` is required for transitive type-resolution only. The host's
      // `sdk.ts` (pointed at by the alias above) references `@/hooks/use-host`
      // and `@/api/resources/types`; those resolve through this project's
      // paths. Plugin authors should NOT import from `@/...` directly — that
      // alias will not exist when a plugin is copied out of this monorepo.
      "@/*": ["../../src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
