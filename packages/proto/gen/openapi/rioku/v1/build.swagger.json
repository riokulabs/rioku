{
  "swagger": "2.0",
  "info": {
    "title": "rioku/v1/build.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "BuildService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/build": {
      "get": {
        "operationId": "BuildService_GetBuildStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1BuildStatus"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "buildId",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "BuildService"
        ]
      },
      "post": {
        "operationId": "BuildService_TriggerBuild",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1BuildEvent"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1BuildEvent"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1BuildRequest"
            }
          }
        ],
        "tags": [
          "BuildService"
        ]
      }
    },
    "/api/v1/build/{buildId}/swap": {
      "post": {
        "operationId": "BuildService_SwapBinary",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SwapResult"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "buildId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BuildServiceSwapBinaryBody"
            }
          }
        ],
        "tags": [
          "BuildService"
        ]
      }
    }
  },
  "definitions": {
    "BuildServiceSwapBinaryBody": {
      "type": "object",
      "properties": {
        "dryRun": {
          "type": "boolean"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1BuildEvent": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/definitions/v1BuildState"
        },
        "message": {
          "type": "string"
        },
        "logLine": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "record": {
          "$ref": "#/definitions/v1BuildRecord"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1BuildRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "target": {
          "$ref": "#/definitions/v1BuildTarget"
        },
        "state": {
          "$ref": "#/definitions/v1BuildState"
        },
        "pluginIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactHash": {
          "type": "string"
        },
        "log": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "buildService": {
          "type": "string"
        },
        "triggeredAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1BuildRequest": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/definitions/v1BuildTarget"
        },
        "pluginIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "v1BuildState": {
      "type": "string",
      "enum": [
        "BUILD_STATE_UNSPECIFIED",
        "BUILD_STATE_IDLE",
        "BUILD_STATE_TRIGGERED",
        "BUILD_STATE_FETCHING_DEPS",
        "BUILD_STATE_BUILDING",
        "BUILD_STATE_TESTING",
        "BUILD_STATE_SWAPPING",
        "BUILD_STATE_COMPLETE",
        "BUILD_STATE_FAILED"
      ],
      "default": "BUILD_STATE_UNSPECIFIED"
    },
    "v1BuildStatus": {
      "type": "object",
      "properties": {
        "caddyBuild": {
          "$ref": "#/definitions/v1BuildRecord"
        },
        "daemonBuild": {
          "$ref": "#/definitions/v1BuildRecord"
        }
      }
    },
    "v1BuildTarget": {
      "type": "string",
      "enum": [
        "BUILD_TARGET_UNSPECIFIED",
        "BUILD_TARGET_CADDY",
        "BUILD_TARGET_DAEMON"
      ],
      "default": "BUILD_TARGET_UNSPECIFIED"
    },
    "v1SwapResult": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "buildId": {
          "type": "string"
        },
        "priorHash": {
          "type": "string"
        },
        "newHash": {
          "type": "string"
        },
        "swappedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
